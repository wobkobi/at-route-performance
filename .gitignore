# Dependencies
node_modules/

# Build / Output
.next/
out/

# Caches
.eslintcache
.cache/
.swc/
coverage/

# Logs
logs/
*.log
npm-debug.log*

# Env files. `vercel env pull` writes .env.local, and can write .env.preview
# and .env.production, so the glob is deliberately wide.
.env*
!.env.example

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS junk
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
.fleet/
.history/

# Misc
*.pem
*.db
tmp/
temp/

# Generated code. Prisma writes into node_modules today; an explicit generator
# output would land here.
generated/

# Puppeteer screenshots from scripts/check-routes.ts
scripts/route-shots/

# One-off exploratory research scripts (kept local, not production code)
scripts/spike-*.ts

# Row dumps the service-day restamp writes before its one destructive delete.
# A local recovery copy of rows that no longer exist anywhere else, so it must
# not be committed, and the tree must not go dirty when the migration runs.
restamp-summary-drop-*.json

# Local-only AT brand asset dump (large PDFs/EPS; not for redistribution or deploy)
public/everything/

# Claude
.claude/
.superpowers/
