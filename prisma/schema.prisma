generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Mode {
  BUS
  TRAIN
  FERRY
}

// Route and Stop use AT's external string IDs as primary keys.
// Rows are never deleted: a route retired from the feed keeps years of retained
// DailyRouteSummary, and its URL has to keep resolving (to redirect to whatever
// replaced it). `lastSeenAt` records the last sync that still found it in AT's
// feed, so directories can list only what currently runs.
model Route {
  id         String              @id @map("_id")
  shortName  String?
  longName   String
  mode       Mode
  colour     String?
  textColour String?
  lastSeenAt DateTime?
  events     ArrivalEvent[]
  tripDelays TripDelay[]
  summaries  DailyRouteSummary[]

  @@index([shortName])
  // Supports the optional mode filter on the top-routes lookup.
  @@index([mode])
  // Supports the "currently in the feed" filter on the route directory.
  @@index([lastSeenAt])
}

// Boardable GTFS stops only; AT's location_type=1 parent stations are dropped at
// ingest. `parentStation` and `platformCode` are AT's own grouping of platforms
// and poles into one station, kept so station collapsing can key off the feed
// instead of stop names.
model Stop {
  id            String         @id @map("_id")
  name          String
  code          String?
  lat           Float
  lon           Float
  parentStation String?
  platformCode  String?
  events        ArrivalEvent[]

  @@index([name])
  // Resolves a station id back to its platforms (stop page, alerts, departures).
  @@index([parentStation])
}

// GTFS shape geometry (from shapes.txt), keyed by AT shape_id.
// `points` is a simplified ordered list of [lon, lat] pairs for the road path.
model Shape {
  id     String @id @map("_id")
  points Json
}

// GTFS trip metadata (from trips.txt), keyed by AT trip_id. `shapeId` names the
// road path the trip drives, which the realtime ingest measures vehicles against.
model TripMeta {
  id          String  @id @map("_id")
  routeId     String?
  headsign    String?
  directionId Int?
  shapeId     String?

  @@map("tripMeta")
}

// One row per observed stop arrival: the scheduled vs actual time and the signed
// deviation (deviationSec) every on-time stat is built from. `source` records how
// it was derived ("AT_GTFSRT" with a real delay, or "AT_GTFSRT_NO_DELAY" for a
// loose zero-delay row excluded from averages). The unique key is the stop VISIT
// (scheduledAt is stable across GTFS-RT re-polls while the predicted actualAt
// keeps moving), so revised predictions upsert the same row instead of
// accumulating one row per revision; rows are pruned after the retention window.
model ArrivalEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  routeId      String
  stopId       String
  tripId       String
  scheduledAt  DateTime
  actualAt     DateTime
  deviationSec Int
  vehicleId    String?
  source       String?
  /// The run's own NZ service date (`YYYY-MM-DD`), set at ingest from the trip
  /// descriptor, so every reading of one run carries one day even when the run
  /// crosses the boundary. A string rather than a day-start instant: an instant
  /// is derived and silently changes meaning when the boundary hour moves.
  /// Nullable permanently - a row written before the backfill, or one whose
  /// descriptor cannot be resolved, must stay readable, and null is truthful.
  serviceDate  String?
  // Set by the nightly pass on readings that sit a vehicle cycle off their own
  // run - AT's trip_id block reuse, not a real delay (see lib/deviation.ts).
  // Absent until that day is classified; rows are flagged, never deleted.
  ghost        Boolean?

  route Route @relation(fields: [routeId], references: [id])
  stop  Stop  @relation(fields: [stopId], references: [id])

  @@unique([tripId, stopId, scheduledAt])
  @@index([routeId, scheduledAt])
  @@index([stopId, scheduledAt])
  // Supports the weekly top/aggregate (date-range filter then group by routeId)
  // and, via its prefix, every plain scheduledAt range and sort - a single-field
  // scheduledAt index would be fully redundant (~65MB at 3M events).
  @@index([scheduledAt, routeId])
  // Supports the per-route by-stop stats: filter by routeId, group by stopId.
  @@index([routeId, stopId])
  // Supports the nightly ghost pass: walk a day's events grouped by trip.
  @@index([scheduledAt, tripId])
}

// Trip-level delay fallback for runs that report only a single `trip_update.delay`
// with no usable stop times, so the trip still contributes a data point rather
// than being dropped. Keyed per (trip, timestamp) to dedupe re-polls, and pruned
// on the same retention schedule as ArrivalEvent.
model TripDelay {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId    String
  routeId   String
  vehicleId String?
  timestamp DateTime
  delaySec  Int
  source    String?

  Route Route @relation(fields: [routeId], references: [id])

  @@unique([tripId, timestamp])
  @@index([routeId, timestamp])
  @@index([timestamp])
}

// One row per ingest run, written by each /api/ingest/* endpoint on success and
// failure. Powers the footer's "last updated" indicator with the real wall-clock
// time ingest last succeeded, so a silently stalled feed reads as stale rather
// than fresh (the newest scheduledAt can sit in the near future even when ingest
// has stopped).
model IngestRun {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  endpoint    String // "at" | "gtfs/sync" | "gtfs/shapes" | "aggregate" | "cleanup"
  startedAt   DateTime
  completedAt DateTime @default(now())
  success     Boolean
  count       Int? // rows inserted/processed (endpoint-specific)
  error       String? // message when success = false
  detail      Json? // endpoint-specific record of what the run decided and did

  @@index([endpoint, completedAt])
}

// Generic key-value store for persisted app settings (e.g. last synced GTFS version).
model Setting {
  id    String @id @map("_id")
  value String

  @@map("setting")
}

/// One reading of a vehicle well off its own trip's road path, written by the
// realtime ingest (see lib/off-route.ts). A detour shows as a run of these with
// arrivals on both sides; a lone reading is GPS drift or a bus driving between
// trips while still signed onto the last one. The unique key drops a position the
// vehicle feed repeats across polls. Pruned on the ArrivalEvent retention window.
model OffRouteSighting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String
  routeId     String
  serviceDate DateTime // NZ service-day start (5am Auckland, stored as UTC)
  seenAt      DateTime // The vehicle position's own timestamp
  lat         Float
  lon         Float
  distanceM   Int
  vehicleId   String?
  // Header of an active detour-type alert on the route when the reading was taken.
  alert       String?

  @@unique([tripId, seenAt])
  @@index([routeId, serviceDate])
  // Supports the retention delete.
  @@index([seenAt])
}

// Pre-aggregated per-route stats for one NZ service day, written by the aggregate
// endpoint so the rankings and week views read summaries instead of rescanning
// millions of raw events. Retained indefinitely for trend history: ArrivalEvent
// and TripDelay are pruned after the retention window, so this is the only lasting
// record of how a route performed.
model DailyRouteSummary {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  routeId        String
  date           DateTime // NZ service-day start (5am Auckland, stored as UTC)
  events         Int
  avgDelaySec    Float?
  avgAbsDelaySec Float?
  onTimePct      Float? // % within threshold
  earlyPct       Float? // % beyond the early-tolerance
  latePct        Float? // % beyond the late-tolerance
  p50DelaySec    Float? // Median
  p95DelaySec    Float? // 95th percentile
  thresholdSec   Int // Threshold used for on-time calc (e.g., 300)
  createdAt      DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id])

  @@unique([routeId, date])
  @@index([date])
}

// One row per cancelled trip per service day, captured from GTFS-RT trip updates
// with schedule_relationship = CANCELED. Those updates carry no stop times, so a
// cancelled trip never becomes an ArrivalEvent and is invisible to the on-time
// stats; this records it so the route trip board can flag it. Forward-only -
// nothing exists before capture began. The unique key lets the per-minute ingest
// upsert idempotently (one row per trip per day, not per poll).
model CancelledTrip {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tripId      String
  routeId     String
  serviceDate DateTime // NZ service-day start (5am Auckland, stored as UTC)
  startTime   String? // GTFS-RT trip start_time "HH:MM:SS", absent on rows ingested before capture
  detectedAt  DateTime @default(now())

  @@unique([tripId, serviceDate])
  @@index([routeId, serviceDate])
}
