// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  BUS
  TRAIN
  FERRY
}

model Route {
  id        String         @id
  shortName String?
  longName  String
  mode      Mode
  events    ArrivalEvent[]
}

model Stop {
  id     String         @id
  name   String
  code   String?
  lat    Float
  lon    Float
  events ArrivalEvent[]
}

model ArrivalEvent {
  id           BigInt   @id @default(autoincrement())
  routeId      String
  stopId       String
  tripId       String
  scheduledAt  DateTime @db.Timestamp(3)
  actualAt     DateTime @db.Timestamp(3)
  deviationSec Int
  vehicleId    String?
  source       String?

  route Route @relation(fields: [routeId], references: [id])
  stop  Stop  @relation(fields: [stopId], references: [id])

  @@unique([tripId, stopId, actualAt])
  @@index([routeId, scheduledAt])
  @@index([stopId, scheduledAt])
}
